# Dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native builds (generated when you build locally)
android/
ios/

# Metro / bundler cache
.metro-health-check*
*.tsbuildinfo

# Debug logs
npm-debug.*
yarn-debug.*
yarn-error.*
*.log

# Environment files (in case anyone adds API keys here later)
.env
.env.*
!.env.example

# Signing keys and certificates, never commit these
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.orig.*

# OS files
.DS_Store
Thumbs.db

# Editor folders (.vscode is deliberately NOT ignored so the team shares settings)
.idea/